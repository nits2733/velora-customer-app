# Backend base URL. Leave empty in dev: the app derives the dev machine host from Metro
# (works for simulators, emulators and physical devices on the same Wi-Fi).
# Set for production builds, e.g. https://velora-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# Public Cloudinary cloud name (NOT the API secret - secrets stay on the backend).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
